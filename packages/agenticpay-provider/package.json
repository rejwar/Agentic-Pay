{
  "name": "@agenticpay/provider",
  "version": "0.1.0",
  "description": "Drop-in x402 paywall middleware for Solana AgenticPay vouchers",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "ts-mocha -p ./tsconfig.json -t 30000 tests/**/*.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
