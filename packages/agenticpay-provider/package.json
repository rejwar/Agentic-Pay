      "uuid": "^9.0.1"
    }
  },
  "devDependencies": {
    "@types/chai": "^4.3.11",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "chai": "^4.3.10",
    "express": "^4.18.2",
    "mocha": "^10.2.0",
    "supertest": "^7.0.0",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.3.3"
  }
